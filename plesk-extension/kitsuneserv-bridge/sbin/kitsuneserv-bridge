#!/usr/bin/env php
<?php

final class KitsuneServBridgeManager
{
    private $config;
    private $varDir;
    private $statePath;
    private $state;
    private $productRoot;
    private $lockHandle;
    private $redactions = [];

    public function __construct($configPath)
    {
        $real = $this->validateRuntimeConfigPath($configPath);
        if (((int) fileperms($real) & 0077) !== 0) throw new RuntimeException('Operation configuration must have mode 0600.');
        $decoded = json_decode((string) file_get_contents($real), true);
        if (!is_array($decoded)) throw new RuntimeException('Invalid operation configuration JSON.');
        $this->config = $decoded;
        $this->varDir = dirname($real);
        $this->statePath = $this->varDir . '/state.json';
        $this->productRoot = dirname(__DIR__, 4);
        $this->state = $this->readState();
        foreach (['git_token', 'git_ssh_private_key', 'bootstrap_password', 'secret_key', 'api_token', 'shared_secret', 'device_token'] as $field) {
            if (!empty($this->config[$field])) $this->redactions[] = (string) $this->config[$field];
        }
        foreach (['repository_path', 'deploy_path', 'data_path'] as $field) {
            $this->config[$field] = $this->validateManagedPath($this->config[$field] ?? '', $field);
        }
        if ($this->pathsOverlap($this->config['repository_path'], $this->config['deploy_path']) ||
            $this->pathsOverlap($this->config['repository_path'], $this->config['data_path']) ||
            $this->pathsOverlap($this->config['deploy_path'], $this->config['data_path'])) {
            throw new RuntimeException('Repository, deployment and data paths must not overlap.');
        }
    }

    public function execute()
    {
        $action = (string) ($this->config['action'] ?? '');
        if (!in_array($action, ['status', 'check', 'sync', 'deploy', 'sync-deploy', 'start', 'stop', 'restart', 'proxy'], true)) {
            throw new RuntimeException('Unsupported operation.');
        }
        if (($this->config['deployment_mode'] ?? 'managed') !== 'managed' && $action !== 'status') {
            throw new RuntimeException('Repository operations are disabled in external Hub mode.');
        }
        $this->acquireLock($action === 'status' ? 2 : 15, $action === 'status' ? 'status.lock' : 'operation.lock');
        $this->state['lastOperation'] = $action;
        $this->state['lastError'] = null;
        try {
            switch ($action) {
                case 'status':
                    $this->refreshState();
                    break;
                case 'check':
                    $this->checkPrerequisites();
                    $this->refreshRepository(true);
                    $this->refreshState();
                    break;
                case 'sync':
                    $this->checkPrerequisites();
                    $this->synchronizeRepository();
                    $this->refreshState();
                    break;
                case 'deploy':
                    $this->checkPrerequisites();
                    $this->deploy();
                    break;
                case 'sync-deploy':
                    $this->checkPrerequisites();
                    $this->synchronizeRepository();
                    $this->deploy();
                    break;
                case 'start':
                case 'stop':
                case 'restart':
                    $this->controlService($action);
                    $this->refreshState();
                    break;
                case 'proxy':
                    $this->configureProxy();
                    $this->refreshState();
                    break;
            }
            $this->state['lastSuccess'] = gmdate('c');
            $this->log('Operacja zakończona: ' . $action . '.');
        } catch (Throwable $exception) {
            $this->state['lastError'] = $this->redact($exception->getMessage());
            $this->log('BŁĄD: ' . $exception->getMessage());
            $this->saveState();
            throw $exception;
        }
        $this->saveState();
    }

    private function checkPrerequisites()
    {
        $this->validatedRepositoryUrl();
        $this->validatedBranch();
        $node = $this->validatedBinary('node_binary');
        $npm = $this->validatedBinary('npm_binary');
        $nodeVersion = trim($this->run([$node, '--version'])['stdout']);
        if (!preg_match('/^v(\d+)\.(\d+)\./', $nodeVersion, $matches) || (int) $matches[1] < 22 || ((int) $matches[1] === 22 && (int) $matches[2] < 19)) {
            throw new RuntimeException('KitsuneServ requires Node.js 22.19 or newer; detected ' . ($nodeVersion ?: 'unknown') . '.');
        }
        $this->run([$npm, '--version']);
        $this->run(['git', '--version']);
        $this->run(['systemctl', '--version']);
        $this->log('Node.js, npm, Git i systemd są dostępne.');
    }

    private function synchronizeRepository()
    {
        $path = $this->config['repository_path'];
        $url = $this->validatedRepositoryUrl();
        $branch = $this->validatedBranch();
        if (!is_dir($path . '/.git')) {
            if (file_exists($path) && count(array_diff(scandir($path), ['.', '..'])) > 0) {
                throw new RuntimeException('Repository path exists but is not an empty Git checkout: ' . $path);
            }
            if (is_dir($path)) @rmdir($path);
            $this->ensureDirectory(dirname($path), 0750);
            $this->log('Klonuję repozytorium ' . $url . ' (' . $branch . ').');
            $this->runGit(['git', 'clone', '--branch', $branch, '--recurse-submodules', $url, $path]);
        } else {
            $origin = trim($this->runGit(['git', '-C', $path, 'remote', 'get-url', 'origin'])['stdout']);
            if ($origin !== $url) $this->runGit(['git', '-C', $path, 'remote', 'set-url', 'origin', $url]);
            $dirty = trim($this->runGit(['git', '-C', $path, 'status', '--porcelain'])['stdout']);
            if ($dirty !== '') throw new RuntimeException('Managed repository contains local changes. Commit or remove them before synchronization.');
            $this->runGit(['git', '-C', $path, 'fetch', '--prune', 'origin']);
            $this->runGit(['git', '-C', $path, 'checkout', '-B', $branch, 'refs/remotes/origin/' . $branch]);
            $this->runGit(['git', '-C', $path, 'reset', '--hard', 'refs/remotes/origin/' . $branch]);
            $this->runGit(['git', '-C', $path, 'submodule', 'update', '--init', '--recursive']);
        }
        $this->refreshRepository(false);
    }

    private function refreshRepository($fetch)
    {
        $path = $this->config['repository_path'];
        $url = $this->validatedRepositoryUrl();
        $branch = $this->validatedBranch();
        if (!is_dir($path . '/.git')) {
            if ($fetch) {
                $remote = trim($this->runGit(['git', 'ls-remote', $url, 'refs/heads/' . $branch])['stdout']);
                $this->state['repository']['remoteCommit'] = preg_split('/\s+/', $remote)[0] ?? null;
            }
            $this->state['repository']['branch'] = $branch;
            $this->state['repository']['localCommit'] = null;
            $this->state['repository']['dirty'] = null;
            $this->state['repository']['updateAvailable'] = null;
            return;
        }
        if ($fetch) $this->runGit(['git', '-C', $path, 'fetch', '--prune', 'origin']);
        $local = trim($this->runGit(['git', '-C', $path, 'rev-parse', 'HEAD'])['stdout']);
        $remoteResult = $this->runGit(['git', '-C', $path, 'rev-parse', '--verify', 'refs/remotes/origin/' . $branch], false);
        $remote = $remoteResult['code'] === 0 ? trim($remoteResult['stdout']) : null;
        $dirty = trim($this->runGit(['git', '-C', $path, 'status', '--porcelain'])['stdout']) !== '';
        $this->state['repository'] = ['branch' => $branch, 'localCommit' => $local ?: null, 'remoteCommit' => $remote ?: null, 'dirty' => $dirty, 'updateAvailable' => $remote ? $local !== $remote : null];
    }

    private function deploy()
    {
        $source = $this->config['repository_path'];
        if (!is_file($source . '/package.json') || !is_file($source . '/package-lock.json') || !is_file($source . '/src/server.js')) {
            throw new RuntimeException('Repository does not contain a complete KitsuneServ server application.');
        }
        $deploy = $this->config['deploy_path'];
        $stage = $deploy . '.stage-' . bin2hex(random_bytes(6));
        $previous = $deploy . '.previous';
        $this->removeTree($stage);
        $this->ensureDirectory($stage, 0750);
        foreach (['package.json', 'package-lock.json', 'src', 'config', 'www', 'utils', 'assets', 'LICENSE', 'README.md', 'SERVICES.md'] as $relative) {
            $from = $source . '/' . $relative;
            if (file_exists($from)) $this->copyTree($from, $stage . '/' . $relative);
        }
        $this->log('Instaluję zależności produkcyjne w katalogu staging.');
        $this->run([$this->validatedBinary('npm_binary'), 'ci', '--omit=dev', '--ignore-scripts=false'], $stage, ['NODE_ENV' => 'production']);
        $manifest = json_decode((string) file_get_contents($stage . '/package.json'), true);
        $version = is_array($manifest) ? (string) ($manifest['version'] ?? '') : '';
        if (!preg_match('/^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/', $version)) throw new RuntimeException('Invalid KitsuneServ package version.');

        $environmentPath = '/etc/kitsuneserv-hub.env';
        $unitPath = '/etc/systemd/system/kitsuneserv-hub.service';
        $previousEnvironment = is_file($environmentPath) ? (string) file_get_contents($environmentPath) : null;
        $previousUnit = is_file($unitPath) ? (string) file_get_contents($unitPath) : null;
        $this->removeTree($previous);
        if (is_dir($deploy) && !rename($deploy, $previous)) throw new RuntimeException('Cannot preserve previous deployment.');
        if (!rename($stage, $deploy)) {
            if (is_dir($previous)) @rename($previous, $deploy);
            throw new RuntimeException('Cannot activate staged deployment.');
        }
        try {
            $this->writeEnvironment();
            $this->writeSystemdUnit();
            $this->run(['systemctl', 'daemon-reload']);
            $this->run(['systemctl', 'enable', 'kitsuneserv-hub.service']);
            $this->applyOwnership();
            $this->run(['systemctl', 'restart', 'kitsuneserv-hub.service']);
            if (($this->config['proxy_mode'] ?? 'managed') === 'managed') $this->configureProxy();
        } catch (Throwable $exception) {
            $this->run(['systemctl', 'stop', 'kitsuneserv-hub.service'], null, [], false);
            $this->removeTree($deploy);
            if (is_dir($previous)) @rename($previous, $deploy);
            $this->restoreFile($environmentPath, $previousEnvironment, 0600);
            $this->restoreFile($unitPath, $previousUnit, 0644);
            $this->run(['systemctl', 'daemon-reload'], null, [], false);
            if (is_dir($deploy) && $previousUnit !== null) $this->run(['systemctl', 'restart', 'kitsuneserv-hub.service'], null, [], false);
            throw new RuntimeException('Deployment rolled back: ' . $exception->getMessage(), 0, $exception);
        }
        $commit = is_dir($source . '/.git') ? trim($this->runGit(['git', '-C', $source, 'rev-parse', 'HEAD'])['stdout']) : null;
        $this->state['deployment'] = ['version' => $version, 'commit' => $commit ?: null, 'path' => $deploy, 'deployedAt' => gmdate('c')];
        $this->refreshState();
    }

    private function writeEnvironment()
    {
        $password = (string) ($this->config['bootstrap_password'] ?? '');
        if ($password === '') throw new RuntimeException('Bootstrap administrator password is required before deployment.');
        $domain = $this->validatedDomain((string) ($this->config['panel_domain'] ?? ''));
        $authMode = (string) ($this->config['auth_mode'] ?? 'hybrid');
        if (!in_array($authMode, ['independent', 'plesk', 'hybrid'], true)) throw new RuntimeException('Invalid Hub authentication mode.');
        $values = [
            'NODE_ENV' => 'production',
            'KITSUNE_HOST' => $this->validatedBindAddress(),
            'KITSUNE_PORT' => (string) $this->validatedPort(),
            'KITSUNE_DATA_DIR' => $this->config['data_path'],
            'KITSUNE_USER' => $this->validatedUsername((string) ($this->config['bootstrap_user'] ?? 'admin')),
            'KITSUNE_PASS' => $password,
            'KITSUNE_SECRET_KEY' => (string) ($this->config['secret_key'] ?? ''),
            'KITSUNE_API_TOKEN' => (string) ($this->config['api_token'] ?? ''),
            'KITSUNE_ALLOWED_IPS' => (string) ($this->config['allowed_ips'] ?? ''),
            'KITSUNE_SAFE_MODE' => ($this->config['safe_mode'] ?? 'false') === 'true' ? '1' : '0',
            'KITSUNE_DISABLE_SYSTEM_INTEGRATION' => ($this->config['disable_system_integration'] ?? 'false') === 'true' ? '1' : '0',
            'KITSUNE_UPDATE_MANIFEST_URL' => (string) ($this->config['update_manifest_url'] ?? ''),
            'KITSUNE_UPDATE_PUBLIC_KEY' => $this->normalizedUpdatePublicKey((string) ($this->config['update_public_key'] ?? '')),
            'KITSUNE_PANEL_DOMAIN' => $domain,
            'KITSUNE_HUB_AUTH_MODE' => $authMode,
            'KITSUNE_HUB_AUTO_PROVISION' => ($this->config['auto_provision'] ?? '1') === '1' ? '1' : '0',
            'KITSUNE_ALLOW_LOCAL_LOGIN' => $authMode === 'plesk' ? '0' : '1',
            'KITSUNE_PLESK_URL' => (string) ($this->config['plesk_url'] ?? ''),
            'KITSUNE_PLESK_CONNECTOR_ID' => (string) ($this->config['connector_id'] ?? ''),
            'KITSUNE_PLESK_CONNECTOR_SECRET' => (string) ($this->config['shared_secret'] ?? ''),
        ];
        $lines = [];
        foreach ($values as $key => $value) $lines[] = $key . '=' . $this->systemdValue((string) $value);
        $this->writeAtomicFile('/etc/kitsuneserv-hub.env', implode("\n", $lines) . "\n", 0600);
    }

    private function writeSystemdUnit()
    {
        $user = trim((string) ($this->config['service_user'] ?? 'root'));
        if (!preg_match('/^[a-z_][a-z0-9_-]{0,31}$/', $user)) throw new RuntimeException('Invalid Linux service user.');
        $result = $this->run(['id', '-u', $user], null, [], false);
        if ($result['code'] !== 0) throw new RuntimeException('Linux service user does not exist: ' . $user);
        $node = $this->validatedBinary('node_binary');
        $deploy = $this->config['deploy_path'];
        $unit = "[Unit]\nDescription=KitsuneServ Hub managed by Plesk\nAfter=network-online.target\nWants=network-online.target\n\n"
            . "[Service]\nType=simple\nUser=" . $user . "\nWorkingDirectory=" . $deploy . "\nEnvironmentFile=/etc/kitsuneserv-hub.env\n"
            . "ExecStart=" . $node . " " . $deploy . "/src/server.js\nRestart=on-failure\nRestartSec=5\nTimeoutStopSec=45\nKillSignal=SIGTERM\nUMask=0077\n"
            . "LimitNOFILE=65536\n\n[Install]\nWantedBy=multi-user.target\n";
        $this->writeAtomicFile('/etc/systemd/system/kitsuneserv-hub.service', $unit, 0644);
    }

    private function applyOwnership()
    {
        $user = trim((string) ($this->config['service_user'] ?? 'root'));
        $this->ensureDirectory($this->config['data_path'], 0750);
        if ($user !== 'root') {
            $this->run(['chown', '-R', $user . ':' . $user, $this->config['deploy_path']]);
            $this->run(['chown', '-R', $user . ':' . $user, $this->config['data_path']]);
        }
    }

    private function controlService($action)
    {
        if (!is_file('/etc/systemd/system/kitsuneserv-hub.service')) throw new RuntimeException('Deploy KitsuneServ before controlling the service.');
        $command = $action === 'start' ? 'start' : ($action === 'stop' ? 'stop' : 'restart');
        $this->run(['systemctl', $command, 'kitsuneserv-hub.service']);
    }

    private function configureProxy()
    {
        if (($this->config['proxy_mode'] ?? 'managed') !== 'managed') throw new RuntimeException('Automatic proxy management is disabled.');
        $domain = $this->validatedDomain((string) ($this->config['domain_name'] ?? $this->config['panel_domain'] ?? ''));
        $vhost = $this->validateVhostPath((string) ($this->config['vhost_system_path'] ?? ''));
        $confDir = $vhost . '/conf';
        $this->ensureDirectory($confDir, 0750);
        $path = $confDir . '/vhost_nginx.conf';
        $original = is_file($path) ? (string) file_get_contents($path) : '';
        $next = $this->managedProxyContents($original, $this->validatedPort());
        $backup = $path . '.kitsuneserv-backup';
        if ($original !== '') $this->writeAtomicFile($backup, $original, 0640);
        $this->writeAtomicFile($path, $next, 0640);
        $httpdmng = $this->productRoot . '/admin/sbin/httpdmng';
        try {
            $this->run([$httpdmng, '--reconfigure-domain', $domain]);
        } catch (Throwable $exception) {
            if ($original === '') @unlink($path); else $this->writeAtomicFile($path, $original, 0640);
            $this->run([$httpdmng, '--reconfigure-domain', $domain], null, [], false);
            throw $exception;
        }
        $this->state['proxy'] = ['mode' => 'managed', 'domain' => $domain, 'configuredAt' => gmdate('c'), 'path' => $path];
        $this->log('Skonfigurowano zarządzany reverse proxy dla ' . $domain . '.');
    }

    private function managedProxyContents($contents, $port)
    {
        $begin = '# BEGIN KITSUNESERV BRIDGE MANAGED';
        $end = '# END KITSUNESERV BRIDGE MANAGED';
        $pattern = '/\n?' . preg_quote($begin, '/') . '.*?' . preg_quote($end, '/') . '\n?/s';
        $base = trim((string) preg_replace($pattern, "\n", $contents));
        if (preg_match('/location\s+(?:=\s*)?\/\s*\{/', $base)) {
            throw new RuntimeException('The selected domain already contains a catch-all nginx location. Use manual mode or remove the conflict.');
        }
        $block = $begin . "\nlocation / {\n"
            . '    proxy_pass http://127.0.0.1:' . $port . ";\n"
            . "    proxy_http_version 1.1;\n"
            . "    proxy_set_header Host \$host;\n"
            . "    proxy_set_header X-Real-IP \$remote_addr;\n"
            . "    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;\n"
            . "    proxy_set_header X-Forwarded-Proto \$scheme;\n"
            . "    proxy_set_header Upgrade \$http_upgrade;\n"
            . "    proxy_set_header Connection \"upgrade\";\n"
            . "    proxy_read_timeout 300s;\n    proxy_send_timeout 300s;\n    proxy_buffering off;\n    client_max_body_size 64m;\n}\n"
            . $end . "\n";
        return rtrim($base) . ($base !== '' ? "\n\n" : '') . $block;
    }

    private function refreshState()
    {
        try { $this->refreshRepository(false); } catch (Throwable $exception) { $this->state['repository']['error'] = $this->redact($exception->getMessage()); }
        $unit = '/etc/systemd/system/kitsuneserv-hub.service';
        $active = $this->run(['systemctl', 'is-active', 'kitsuneserv-hub.service'], null, [], false);
        $enabled = $this->run(['systemctl', 'is-enabled', 'kitsuneserv-hub.service'], null, [], false);
        $pidResult = $this->run(['systemctl', 'show', '--property=MainPID', '--value', 'kitsuneserv-hub.service'], null, [], false);
        $health = null;
        if ($active['code'] === 0) {
            $context = stream_context_create(['http' => ['timeout' => 2, 'ignore_errors' => true]]);
            $response = @file_get_contents('http://127.0.0.1:' . $this->validatedPort() . '/', false, $context);
            $health = $response !== false;
        }
        $this->state['service'] = [
            'installed' => is_file($unit),
            'active' => $active['code'] === 0 && trim($active['stdout']) === 'active',
            'enabled' => $enabled['code'] === 0 && trim($enabled['stdout']) === 'enabled',
            'health' => $health,
            'pid' => max(0, (int) trim($pidResult['stdout'])),
        ];
    }

    private function runGit(array $command, $throw = true)
    {
        $environment = ['GIT_TERMINAL_PROMPT' => '0'];
        $temporary = [];
        try {
            $url = (string) ($this->config['repository_url'] ?? '');
            $token = (string) ($this->config['git_token'] ?? '');
            if ($token !== '' && strpos($url, 'https://') === 0) {
                $askPass = $this->varDir . '/git-askpass-' . bin2hex(random_bytes(6)) . '.sh';
                file_put_contents($askPass, "#!/bin/sh\ncase \"\$1\" in *Username*) printf '%s\\n' \"\$KITSUNE_GIT_USERNAME\" ;; *) printf '%s\\n' \"\$KITSUNE_GIT_TOKEN\" ;; esac\n", LOCK_EX);
                chmod($askPass, 0700);
                $temporary[] = $askPass;
                $environment['GIT_ASKPASS'] = $askPass;
                $environment['KITSUNE_GIT_USERNAME'] = (string) ($this->config['git_username'] ?: 'x-access-token');
                $environment['KITSUNE_GIT_TOKEN'] = $token;
            }
            $isSsh = strpos($url, 'ssh://') === 0 || strpos($url, 'git@') === 0;
            if ($isSsh) {
                $known = trim((string) ($this->config['git_ssh_known_hosts'] ?? ''));
                if ($known === '') throw new RuntimeException('SSH repository requires verified known_hosts content.');
                $knownPath = $this->varDir . '/known-hosts-' . bin2hex(random_bytes(6));
                file_put_contents($knownPath, $known . "\n", LOCK_EX); chmod($knownPath, 0600); $temporary[] = $knownPath;
                $ssh = 'ssh -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=' . escapeshellarg($knownPath);
                $key = trim((string) ($this->config['git_ssh_private_key'] ?? ''));
                if ($key !== '') {
                    $keyPath = $this->varDir . '/git-key-' . bin2hex(random_bytes(6));
                    file_put_contents($keyPath, $key . "\n", LOCK_EX); chmod($keyPath, 0600); $temporary[] = $keyPath;
                    $ssh .= ' -i ' . escapeshellarg($keyPath);
                }
                $environment['GIT_SSH_COMMAND'] = $ssh;
            }
            return $this->run($command, null, $environment, $throw);
        } finally {
            foreach ($temporary as $path) if (is_file($path)) @unlink($path);
        }
    }

    private function run(array $command, $cwd = null, array $extraEnvironment = [], $throw = true)
    {
        if (!$command) throw new RuntimeException('Empty command.');
        foreach ($command as $argument) if (!is_scalar($argument) || strpos((string) $argument, "\0") !== false) throw new RuntimeException('Invalid process argument.');
        $line = implode(' ', array_map('escapeshellarg', array_map('strval', $command)));
        $environment = getenv(); if (!is_array($environment)) $environment = [];
        $environment['PATH'] = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin';
        foreach ($extraEnvironment as $key => $value) $environment[$key] = (string) $value;
        $descriptor = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
        $process = proc_open($line, $descriptor, $pipes, $cwd, $environment);
        if (!is_resource($process)) throw new RuntimeException('Cannot start ' . $command[0]);
        fclose($pipes[0]); $stdout = stream_get_contents($pipes[1]); $stderr = stream_get_contents($pipes[2]); fclose($pipes[1]); fclose($pipes[2]);
        $code = proc_close($process); $stdout = $this->redact($stdout); $stderr = $this->redact($stderr);
        if ($throw && $code !== 0) {
            $detail = trim(($stderr !== '' ? $stderr . "\n" : '') . $stdout);
            throw new RuntimeException($command[0] . ' failed (' . $code . '): ' . mb_substr($detail ?: 'no details', -5000));
        }
        return ['code' => $code, 'stdout' => $stdout, 'stderr' => $stderr];
    }

    private function validatedRepositoryUrl()
    {
        $url = trim((string) ($this->config['repository_url'] ?? ''));
        if (!preg_match('#^(?:https://[^\s]+|ssh://[^\s]+|git@[A-Za-z0-9.-]+:[A-Za-z0-9._~/-]+)$#', $url)) throw new RuntimeException('Repository URL must use HTTPS or SSH.');
        if (preg_match('/[\r\n\0]/', $url) || strlen($url) > 1000) throw new RuntimeException('Invalid repository URL.');
        $parts = strpos($url, 'git@') === 0 ? null : parse_url($url);
        if (is_array($parts) && (isset($parts['pass']) || (($parts['scheme'] ?? '') === 'https' && isset($parts['user'])))) throw new RuntimeException('Repository credentials must use the encrypted credential fields, not the URL.');
        return $url;
    }

    private function validatedBranch()
    {
        $branch = trim((string) ($this->config['repository_branch'] ?? 'main'));
        if (!preg_match('/^(?![-.])(?!.*\.\.)(?!.*@\{)[A-Za-z0-9._\/-]+$/', $branch) || strlen($branch) > 200) throw new RuntimeException('Invalid Git branch.');
        return $branch;
    }

    private function validatedBinary($field)
    {
        $value = trim((string) ($this->config[$field] ?? ''));
        if (!preg_match('#^/[A-Za-z0-9._/-]+$#', $value) || strpos($value, '..') !== false || !is_file($value) || !is_executable($value)) throw new RuntimeException('Invalid or non-executable ' . $field . ': ' . $value);
        return $value;
    }

    private function validatedPort()
    {
        $port = filter_var($this->config['hub_port'] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1024, 'max_range' => 65535]]);
        if ($port === false) throw new RuntimeException('Hub port must be between 1024 and 65535.');
        return (int) $port;
    }

    private function validatedBindAddress()
    {
        $value = trim((string) ($this->config['bind_address'] ?? '127.0.0.1'));
        if (!in_array($value, ['127.0.0.1', '::1'], true)) throw new RuntimeException('Managed Hub must bind to loopback.');
        return $value;
    }

    private function validatedUsername($value)
    {
        if (!preg_match('/^[A-Za-z0-9._@+-]{3,100}$/', $value)) throw new RuntimeException('Invalid bootstrap username.');
        return $value;
    }

    private function validatedDomain($value)
    {
        $value = strtolower(trim($value));
        if (!preg_match('/^(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]*$/', $value)) throw new RuntimeException('Invalid panel domain.');
        return $value;
    }

    private function validateRuntimeConfigPath($path)
    {
        $productRoot = dirname(__DIR__, 4);
        $expected = realpath($productRoot . '/var/modules/kitsuneserv-bridge');
        $real = realpath((string) $path);
        if ($expected === false || $real === false || dirname($real) !== $expected || !preg_match('/^operation-[a-f0-9]{24}\.json$/', basename($real))) {
            throw new RuntimeException('Operation configuration is outside the extension state directory.');
        }
        return $real;
    }

    private function validateManagedPath($value, $field)
    {
        $value = rtrim(str_replace('\\', '/', trim((string) $value)), '/');
        if (!preg_match('#^/(?:home|opt|srv|var/lib)/[A-Za-z0-9._/-]+$#', $value) || in_array('..', explode('/', $value), true)) {
            throw new RuntimeException('Unsafe ' . $field . '. Use a dedicated path below /home, /opt, /srv or /var/lib.');
        }
        $this->assertNoSymlinkComponents($value, $field);
        return $value;
    }

    private function assertNoSymlinkComponents($path, $field)
    {
        $current = '';
        foreach (explode('/', ltrim((string) $path, '/')) as $segment) {
            $current .= '/' . $segment;
            if (is_link($current)) throw new RuntimeException('Unsafe symlink in ' . $field . ': ' . $current);
            if (!file_exists($current)) break;
        }
    }

    private function validateVhostPath($value)
    {
        $value = rtrim(str_replace('\\', '/', trim($value)), '/');
        if (!preg_match('#^/var/www/vhosts/system/[A-Za-z0-9.-]+$#', $value) || in_array('..', explode('/', $value), true)) throw new RuntimeException('Unsafe Plesk vhost path.');
        return $value;
    }

    private function systemdValue($value)
    {
        if (preg_match('/[\r\n\0]/', $value)) throw new RuntimeException('Environment values cannot contain line breaks.');
        return '"' . str_replace(['\\', '"'], ['\\\\', '\\"'], $value) . '"';
    }

    private function normalizedUpdatePublicKey($value)
    {
        $value = trim((string) $value);
        if ($value === '') return '';
        $value = preg_replace('/-----BEGIN [^-]+-----|-----END [^-]+-----|\s+/', '', $value);
        if (!is_string($value) || $value === '' || !preg_match('/^[A-Za-z0-9+\/=]+$/', $value) || base64_decode($value, true) === false) {
            throw new RuntimeException('Update public key must be a PEM or base64-encoded SPKI key.');
        }
        return $value;
    }

    private function writeAtomicFile($path, $contents, $mode)
    {
        $temporary = dirname($path) . '/.' . basename($path) . '.kitsune-' . bin2hex(random_bytes(6));
        if (file_put_contents($temporary, $contents, LOCK_EX) === false) throw new RuntimeException('Cannot write temporary file: ' . $path);
        chmod($temporary, $mode);
        if (!rename($temporary, $path)) { @unlink($temporary); throw new RuntimeException('Cannot activate file: ' . $path); }
    }

    private function restoreFile($path, $contents, $mode)
    {
        if ($contents === null) {
            if (is_file($path) || is_link($path)) @unlink($path);
            return;
        }
        $this->writeAtomicFile($path, $contents, $mode);
    }

    private function copyTree($source, $target)
    {
        if (is_link($source)) throw new RuntimeException('Deployment source contains an unsupported symlink: ' . $source);
        if (is_dir($source)) {
            $this->ensureDirectory($target, 0750);
            foreach (new FilesystemIterator($source, FilesystemIterator::SKIP_DOTS) as $item) {
                if (in_array($item->getFilename(), ['node_modules', '.git', 'artifacts'], true)) continue;
                $this->copyTree($item->getPathname(), $target . '/' . $item->getFilename());
            }
            return;
        }
        $this->ensureDirectory(dirname($target), 0750);
        if (!copy($source, $target)) throw new RuntimeException('Cannot copy deployment file: ' . $source);
        chmod($target, 0640);
    }

    private function removeTree($path)
    {
        if (!file_exists($path) && !is_link($path)) return;
        if (is_link($path) || is_file($path)) {
            if (!@unlink($path)) throw new RuntimeException('Cannot remove deployment path: ' . $path);
            return;
        }
        if (!is_dir($path)) throw new RuntimeException('Unsupported deployment path: ' . $path);
        foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::CHILD_FIRST) as $item) {
            if ($item->isLink() || $item->isFile()) @unlink($item->getPathname()); else @rmdir($item->getPathname());
        }
        @rmdir($path);
    }

    private function ensureDirectory($path, $mode)
    {
        if (!is_dir($path) && !mkdir($path, $mode, true) && !is_dir($path)) throw new RuntimeException('Cannot create directory: ' . $path);
        chmod($path, $mode);
    }

    private function pathsOverlap($left, $right)
    {
        $left = rtrim((string) $left, '/'); $right = rtrim((string) $right, '/');
        return $left === $right || strpos($left . '/', $right . '/') === 0 || strpos($right . '/', $left . '/') === 0;
    }

    private function acquireLock($seconds, $name)
    {
        if (!in_array($name, ['operation.lock', 'status.lock'], true)) throw new RuntimeException('Invalid lock name.');
        $this->lockHandle = fopen($this->varDir . '/' . $name, 'c');
        if (!is_resource($this->lockHandle)) throw new RuntimeException('Cannot open operation lock.');
        $until = microtime(true) + $seconds;
        do { if (flock($this->lockHandle, LOCK_EX | LOCK_NB)) return; usleep(250000); } while (microtime(true) < $until);
        throw new RuntimeException('Another KitsuneServ Bridge operation is running.');
    }

    private function readState()
    {
        $empty = ['updatedAt' => null, 'lastOperation' => null, 'lastSuccess' => null, 'lastError' => null, 'repository' => [], 'deployment' => [], 'service' => [], 'proxy' => [], 'log' => []];
        if (!is_file($this->statePath)) return $empty;
        $decoded = json_decode((string) file_get_contents($this->statePath), true);
        return is_array($decoded) ? array_replace_recursive($empty, $decoded) : $empty;
    }

    private function saveState()
    {
        $this->state['updatedAt'] = gmdate('c');
        $json = json_encode($this->state, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
        $this->writeAtomicFile($this->statePath, $json . "\n", 0640);
    }

    private function redact($value)
    {
        return $this->redactions ? str_replace($this->redactions, '[REDACTED]', (string) $value) : (string) $value;
    }

    private function log($message)
    {
        $line = '[' . gmdate('Y-m-d H:i:s') . ' UTC] ' . $this->redact($message);
        $this->state['log'][] = $line;
        $this->state['log'] = array_slice($this->state['log'], -300);
        fwrite(STDOUT, $line . PHP_EOL);
    }
}

function kitsuneConfigPath(array $arguments)
{
    if (count($arguments) !== 3 || $arguments[1] !== '--config') throw new RuntimeException('Usage: kitsuneserv-bridge --config /secure/operation.json');
    return (string) $arguments[2];
}

umask(0077);
try {
    (new KitsuneServBridgeManager(kitsuneConfigPath($argv)))->execute();
    exit(0);
} catch (Throwable $error) {
    fwrite(STDERR, 'KitsuneServ Bridge: ' . $error->getMessage() . PHP_EOL);
    exit(1);
}
