{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitsuneserv.local/schemas/terminal-files-adapter-v2.json",
  "title": "KitsuneServ Terminal & Files Declarative Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["pluginId", "name", "kind", "sdkVersion", "capabilities"],
  "properties": {
    "pluginId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,80}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "kind": { "enum": ["protocol", "storage", "preview", "action"] },
    "sdkVersion": { "const": 2 },
    "protocols": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]{0,39}$" } },
    "mimeTypes": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "maxLength": 100 } },
    "capabilities": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,79}$" } },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "enum": ["network", "filesystem-read", "filesystem-write", "remote-exec"] } },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "const": true },
        "approvalFor": { "type": "array", "uniqueItems": true, "items": { "enum": ["filesystem-write", "remote-exec"] } }
      }
    }
  }
}
