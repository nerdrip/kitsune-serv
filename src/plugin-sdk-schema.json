{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitsuneserv.local/schemas/workspace-plugin-v1.json",
  "title": "KitsuneServ Workspace Plugin",
  "type": "object",
  "additionalProperties": false,
  "required": ["pluginId", "name", "kind", "sdkVersion"],
  "properties": {
    "pluginId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,80}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "kind": { "enum": ["protocol", "preview", "action"] },
    "sdkVersion": { "const": 1 },
    "entry": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,160}$" },
    "mimeTypes": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 100 } },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["network", "filesystem-read", "filesystem-write", "remote-exec"] }
    }
  }
}
