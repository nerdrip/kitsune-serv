FROM node:24-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends fakeroot rpm \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run check && npm test && npm run build:linux

FROM node:24-bookworm-slim AS smoke
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates dbus-x11 libasound2 libatk-bridge2.0-0 libatk1.0-0 libcairo2 libcups2 libdrm2 libgbm1 libgtk-3-0 libnss3 libpango-1.0-0 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 xauth xvfb \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /workspace/artifacts/linux /workspace/artifacts/linux
RUN KITSUNE_SMOKE_TEST=1 xvfb-run -a /workspace/artifacts/linux/linux-unpacked/kitsuneserv --no-sandbox --smoke-test

FROM scratch AS export
COPY --from=smoke /workspace/artifacts/linux /
